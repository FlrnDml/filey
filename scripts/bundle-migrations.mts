/**
 * Bundles the SQL migrations generated by drizzle-kit (`drizzle/<timestamp>_<name>/migration.sql`) into
 * `src/core/db/migrations.generated.ts`, so the packaged app carries them in its code and needs no
 * migrations folder at runtime (arc42 §8 "Data storage and migrations").
 *
 *   npm run db:generate                      drizzle-kit generate, then this script
 *   node scripts/bundle-migrations.mts --check  exit 1 if the bundled file is out of date
 *
 * `src/core/db/migrations.test.ts` fails when the bundled file does not match `drizzle/`.
 */
import { readFileSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';
import { readMigrationFiles } from 'drizzle-orm/migrator';

const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..');
export const MIGRATIONS_FOLDER = join(ROOT, 'drizzle');
export const BUNDLED_MIGRATIONS_PATH = join(ROOT, 'src/core/db/migrations.generated.ts');

export function renderBundledMigrations(folder = MIGRATIONS_FOLDER): string {
  const migrations = readMigrationFiles({ migrationsFolder: folder });
  return [
    '// Generated by scripts/bundle-migrations.mts from drizzle/. Do not edit; run `npm run db:generate`.',
    "import type { MigrationMeta } from 'drizzle-orm/migrator';",
    '',
    `export const BUNDLED_MIGRATIONS: MigrationMeta[] = ${JSON.stringify(migrations, null, 2)};`,
    '',
  ].join('\n');
}

if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
  const content = renderBundledMigrations();
  if (process.argv.includes('--check')) {
    if (readFileSync(BUNDLED_MIGRATIONS_PATH, 'utf8') !== content) {
      console.error('src/core/db/migrations.generated.ts is out of date: run `npm run db:generate`.');
      process.exit(1);
    }
  } else {
    writeFileSync(BUNDLED_MIGRATIONS_PATH, content);
  }
}
