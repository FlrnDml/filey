/**
 * Generates `src/renderer/styles/tokens.css` from `docs/design-system/tokens.json`.
 *
 *   npm run tokens          write the CSS file
 *   npm run tokens -- --check  exit 1 if the committed file is out of date
 *
 * `test/tokens.test.ts` fails when the committed CSS does not match the JSON, so a token
 * change only needs this script to be run again.
 */
import { readFileSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';

type Themed = string | { light: string; dark: string };

interface NamedToken<V> {
  name: string;
  value: V;
  usage?: string;
}

interface TypeStyle {
  name: string;
  fontSize: string;
  lineHeight: string;
  fontWeight: number;
  letterSpacing?: string;
  usage?: string;
}

export interface DesignTokens {
  color: { tokens: NamedToken<Themed>[] };
  type: {
    families: Record<string, string>;
    groups: { name: string; family: string; styles: TypeStyle[] }[];
  };
  spacing: { tokens: NamedToken<string>[] };
  radius: { tokens: NamedToken<string>[] };
  shadow: { tokens: NamedToken<Themed>[] };
}

const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..');
export const TOKENS_JSON_PATH = join(ROOT, 'docs/design-system/tokens.json');
export const TOKENS_CSS_PATH = join(ROOT, 'src/renderer/styles/tokens.css');

const REFERENCE = /^\{([a-z0-9-]+)\}$/;

/** Resolves `{other-token}` references (e.g. `focus-ring` -> `accent`) to a concrete per-theme value. */
function resolve(tokens: NamedToken<Themed>[], name: string, theme: 'light' | 'dark', seen: string[] = []): string {
  if (seen.includes(name)) throw new Error(`Circular token reference: ${[...seen, name].join(' -> ')}`);
  const token = tokens.find((t) => t.name === name);
  if (!token) throw new Error(`Unknown token reference: {${name}}`);
  const raw = typeof token.value === 'string' ? token.value : token.value[theme];
  const ref = REFERENCE.exec(raw);
  return ref ? resolve(tokens, ref[1]!, theme, [...seen, name]) : raw;
}

function themed(tokens: NamedToken<Themed>[], theme: 'light' | 'dark'): string[] {
  return tokens.map((t) => `  --${t.name}: ${resolve(tokens, t.name, theme)};`);
}

/** Pure function from the token JSON to the CSS text, so it can be tested without touching the disk. */
export function renderTokensCss(tokens: DesignTokens): string {
  const themedTokens = [...tokens.color.tokens, ...tokens.shadow.tokens];
  const families = Object.entries(tokens.type.families).map(([name, value]) => `  --font-${name}: ${value};`);
  const typeVars: string[] = [];
  const typeClasses: string[] = [];
  for (const group of tokens.type.groups) {
    for (const style of group.styles) {
      typeVars.push(
        `  --type-${style.name}: ${style.fontWeight} ${style.fontSize}/${style.lineHeight} var(--font-${group.family});`,
        `  --type-${style.name}-tracking: ${style.letterSpacing ?? 'normal'};`,
      );
      typeClasses.push(
        `.type-${style.name} {\n  font: var(--type-${style.name});\n  letter-spacing: var(--type-${style.name}-tracking);\n}`,
      );
    }
  }
  const plain = [...tokens.spacing.tokens, ...tokens.radius.tokens].map((t) => `  --${t.name}: ${t.value};`);

  return [
    '/* Generated by scripts/build-tokens.mts from docs/design-system/tokens.json. Do not edit by hand: run `npm run tokens`. */',
    '',
    ':root {',
    '  color-scheme: light dark;',
    ...themed(themedTokens, 'light'),
    ...families,
    ...typeVars,
    ...plain,
    '}',
    '',
    '@media (prefers-color-scheme: dark) {',
    '  :root {',
    ...themed(themedTokens, 'dark').map((line) => `  ${line}`),
    '  }',
    '}',
    '',
    ...typeClasses.flatMap((c) => [c, '']),
  ].join('\n');
}

export function readTokens(path = TOKENS_JSON_PATH): DesignTokens {
  return JSON.parse(readFileSync(path, 'utf8')) as DesignTokens;
}

if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
  const css = renderTokensCss(readTokens());
  if (process.argv.includes('--check')) {
    const current = readFileSync(TOKENS_CSS_PATH, 'utf8');
    if (current !== css) {
      console.error('src/renderer/styles/tokens.css is out of date. Run `npm run tokens`.');
      process.exit(1);
    }
    console.log('tokens.css is up to date.');
  } else {
    writeFileSync(TOKENS_CSS_PATH, css);
    console.log(`Wrote ${TOKENS_CSS_PATH}`);
  }
}
