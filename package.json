{
  "name": "filey",
  "engines": {
    "node": "24.22.0"
  },
  "main": ".webpack/main/index.cjs",
  "scripts": {
    "start": "FILEY_DEV_VERSION=0.0.0-dev electron-forge start",
    "package": "electron-forge package",
